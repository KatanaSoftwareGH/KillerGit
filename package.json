{
  "name": "killergit",
  "productName": "KillerGit",
  "version": "0.1.0",
  "description": "Lightweight Git desktop client with node graphs, multi-remote, issues and native OpenSSH",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "author": "Drake",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.killergit.app",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis", "signAndEditExecutable": false }
  }
}
